# Caddyfile — "Цифровой помощник лесовода", Блок 4 (развёртывание).
#
# Что делает:
#   - отдаёт собранный фронтенд (frontend/dist) статикой;
#   - всё, что начинается с /api/, проксирует на uvicorn (127.0.0.1:8000);
#   - для путей без расширения (React Router) отдаёт index.html, а не 404.
#
# Установка Caddy (Windows): https://caddyserver.com/docs/install#windows
# скачать caddy.exe, положить, например, в C:\lesovod\caddy\caddy.exe.
# Запуск вручную для проверки:
#   C:\lesovod\caddy\caddy.exe run --config C:\lesovod\deploy\Caddyfile
# Постоянный запуск — тем же способом, что и backend (см. install_service.bat
# в этой папке: тот же nssm, второй сервис, Application = caddy.exe,
# Arguments = run --config C:\lesovod\deploy\Caddyfile).
#
# Перед первым запуском поправьте:
#   1. "192.168.X.Y" ниже — замените на реальный статический IP сервера
#      (закреплённый DHCP reservation, см. README.md п.4). Без этого адреса
#      телефон/другие устройства в той же сети не смогут подключиться по IP
#      (Caddy матчит запрос строго по Host-заголовку из этого списка).
#   2. Путь root ниже — куда реально распакован `npm run build` фронтенда.

lesovod.local, localhost, 192.168.100.6, http://lesovodapipom.store {
	encode gzip

	# Собранный фронтенд. Путь — абсолютный, поправьте под реальное
	# расположение (куда скопирован frontend/dist после `npm run build`).
	root * C:/lesovod/frontend/dist

	# Прокси API — идёт первым: handle-блоки в Caddy взаимоисключающие
	# и проверяются по порядку, поэтому /api/* не должен долетать до
	# file_server ниже.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /docs* {
    		reverse_proxy 127.0.0.1:8000
	}
	handle /openapi.json {
    		reverse_proxy 127.0.0.1:8000
	}
	# Всё остальное — статика; для путей без файла (client-side роуты
	# React Router, например /raskhod или /map) отдаём index.html, а не
	# 404, чтобы обновление страницы на внутреннем маршруте не ломалось.
	handle {
		try_files {path} /index.html
		file_server
	}
}

# HTTPS: если сервер видит интернет (не только локальная сеть) и есть
# настоящий домен — замените адрес выше на этот домен, Caddy сам получит
# сертификат Let's Encrypt, ничего больше настраивать не нужно.
# Если нужен HTTPS только внутри локальной сети без настоящего домена —
# добавьте строку `tls internal` первой строкой внутри блока выше:
# Caddy выпустит самоподписанный сертификат; браузерам придётся один раз
# подтвердить исключение безопасности (сертификат не публично доверенный).
